{
  "name": "Gold and Copper",
  "dataColors": ["#C9A227", "#B87333", "#2B3A55", "#4F8A8B", "#8E9AAF", "#A33B3B", "#6C5B7B", "#D9C38B"],
  "background": "#FFFFFF",
  "foreground": "#23262D",
  "tableAccent": "#C9A227",
  "good": "#2E8B57",
  "neutral": "#E8B04B",
  "bad": "#C0392B",
  "maximum": "#C9A227",
  "center": "#F3E9CF",
  "minimum": "#FFFFFF",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#23262D" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#23262D" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5A5F6B" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#23262D" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F1ED" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E2DED6" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false, "radius": 10 }],
        "dropShadow": [{
          "show": true, "color": { "solid": { "color": "#14161B" } }, "position": "Outer", "preset": "Custom",
          "shadowSpread": 0, "shadowBlur": 12, "angle": 90, "shadowDistance": 3, "transparency": 88
        }],
        "title": [{ "fontColor": { "solid": { "color": "#23262D" } }, "fontFamily": "Segoe UI Semibold" }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#7A7F8A" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#23262D" } }, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#23262D" } }, "fontFamily": "Segoe UI Semibold" }],
        "dropShadow": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#23262D" } }, "backColor": { "solid": { "color": "#F3E9CF" } },
          "fontFamily": "Segoe UI Semibold"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#23262D" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#23262D" } }, "backColorSecondary": { "solid": { "color": "#FAF7F1" } }
        }],
        "total": [{ "fontColor": { "solid": { "color": "#23262D" } }, "backColor": { "solid": { "color": "#F3E9CF" } } }],
        "grid": [{ "outlineColor": { "solid": { "color": "#C9A227" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#23262D" } }, "backColor": { "solid": { "color": "#F3E9CF" } },
          "fontFamily": "Segoe UI Semibold"
        }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#23262D" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#23262D" } }, "backColor": { "solid": { "color": "#F3E9CF" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
